# uStreamer 运行参数
# 改完执行: sudo systemctl restart ustreamer
#
# 摄像头(icSpring UVC)支持的 MJPEG 分辨率与实测码率(满速 57fps):
#   1920x1080  244KB/帧  约 114 Mbps
#   1280x720   131KB/帧  约  61 Mbps   <- 默认，5GHz 下余量充足
#   800x600     77KB/帧  约  36 Mbps
#   640x480     42KB/帧  约  19 Mbps   <- 2.4GHz 或弱网时用这个

RESOLUTION=1280x720
FPS=60
PORT=8080
